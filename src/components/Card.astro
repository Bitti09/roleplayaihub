---
import { ExternalLink } from '@lucide/astro';
import { getIntlayer } from 'intlayer';
import type { ResourceData } from '../content.config';
import { idFromName } from '../lib/slugify';
import { colorForName } from '../lib/colors';
import { resolveIcon } from '../lib/icons';
import TagList from './TagList.astro';

interface Props {
  data: ResourceData;
}

const { data } = Astro.props;
const { name, description, url, tags, icon } = data;

const cardId = idFromName(name);
const IconComponent = resolveIcon(icon);
const iconColors = colorForName(name);
const { visitSite } = getIntlayer('common');
---

<div class="card glass-panel glass-panel-hover overflow-hidden rounded-2xl transition-all duration-300">
  <div class="card-body p-6 flex flex-col justify-between h-full gap-4">
    <div>
      <div class="flex items-center gap-3.5">
        <div class={`p-2.5 rounded-xl border flex items-center justify-center shrink-0 ${iconColors}`}>
          <IconComponent class="w-5 h-5" />
        </div>
        <h3 id={cardId} class="text-lg font-semibold text-base-content transition-colors scroll-mt-24">
          {name}
        </h3>
      </div>
      <p class="text-sm text-base-content/70 mt-4 leading-relaxed line-clamp-3">
        {description}
      </p>
    </div>

    <div class="flex flex-col gap-3.5 mt-2">
      <TagList tags={tags} />

      {url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-outline border-base-content/20 hover:border-pink-500/50 hover:bg-pink-500/5 text-base-content/85 hover:text-base-content rounded-lg flex items-center justify-between w-full mt-1.5"
        >
          <span>{visitSite}</span>
          <ExternalLink class="w-3.5 h-3.5 ml-1 opacity-70" />
        </a>
      )}
    </div>
  </div>
</div>