---
import {
  Calendar,
  User,
  ShieldCheck,
  TriangleAlert,
  CircleAlert,
} from '@lucide/astro';
import {
  getIntlayer,
  getLocaleFromPath,
  defaultLocale,
  getPathWithoutLocale,
  getLocalizedUrl,
  type LocalesValues,
} from 'intlayer';
import type { ModelData } from '../content.config';
import { idFromName } from '../lib/slugify';
import { colorForName } from '../lib/colors';
import { resolveIcon } from '../lib/icons';
import { resolveLocalized } from '../lib/localized';
import Capabilities from './Capabilities.astro';

interface Props {
  data: ModelData;
}

const { data } = Astro.props;

const {
  name,
  author,
  released,
  description,
  context,
  license,
  nsfw,
  capabilities,
  artifacts,
} = data;

const primaryArtifact = artifacts[0];
const artifactFormat = primaryArtifact?.format ?? 'N/A';
const artifactSize = primaryArtifact?.size ?? 'N/A';

const cardId = idFromName(name);
const IconComponent = resolveIcon(data.icon);

/**
 * Resolve the current locale for this card render. The card is reused
 * across both the unprefixed default pages (`/ai-models/...`) and the
 * locale-prefixed pages (`/de/ai-models/...`), so we read the URL path
 * instead of relying on a `lang` prop.
 */
const detectedLocale = getLocaleFromPath(Astro.url.pathname) as
  | LocalesValues
  | undefined;
const currentLocale: LocalesValues = (detectedLocale ??
  defaultLocale) as LocalesValues;
const localizedDescription = resolveLocalized(description, currentLocale);
const cardHref = getLocalizedUrl(
  getPathWithoutLocale(`/ai-models/${cardId}`),
  currentLocale,
);

/**
 * Pull the `text-*` class out of the palette so we can paint the bare icon
 * (no colored tile around it anymore).
 */
const iconColor =
  colorForName(name).split(' ').find((c) => c.startsWith('text-')) ?? 'text-pink-400';

const common = getIntlayer('common', currentLocale);
const detail = getIntlayer('model-detail', currentLocale);

function localizeLicense(value: string | undefined): string | undefined {
  if (!value) return value;
  const normalized = value.trim().toLowerCase();
  if (normalized === 'open weight' || normalized === 'open-weight') {
    return common.licenseOpenWeight;
  }
  if (normalized === 'proprietary') {
    return common.licenseProprietary;
  }
  return value;
}

const localizedLicense = localizeLicense(license);

/**
 * NSFW content-policy pill — visible on every card because content
 * classification is essential for an AI-model hub.
 * The visible label self-describes (subject + state); the pill itself acts as
 * the accessible name, so we deliberately skip a redundant aria-label.
 */
type NsfwValue = NonNullable<ModelData['nsfw']>;
const nsfwPill: Record<
  NsfwValue,
  { label: string; classes: string; Icon: typeof TriangleAlert }
> = {
  allowed: {
    label: detail.nsfwPillAllowed,
    classes: 'bg-emerald-500/15 border-emerald-500/30 text-emerald-400',
    Icon: TriangleAlert,
  },
  limited: {
    label: detail.nsfwPillLimited,
    classes: 'bg-amber-500/15 border-amber-500/30 text-amber-400',
    Icon: CircleAlert,
  },
  blocked: {
    label: detail.nsfwPillBlocked,
    classes: 'bg-red-500/15 border-red-500/30 text-red-400',
    Icon: ShieldCheck,
  },
};
const nsfwInfo = nsfwPill[nsfw ?? 'blocked'];

---

<article
  class="card glass-panel overflow-hidden rounded-2xl border border-base-content/10 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_42px_-10px] hover:shadow-pink-500/30 hover:border-pink-500/35 flex flex-col"
>
  <div class="px-5 pt-5 pb-4 flex flex-col gap-3.5 grow">
    <!-- Header: small icon + name on top, slug id + NSFW pill below -->
    <header class="flex items-start gap-2.5 min-w-0">
      <IconComponent class={`w-5 h-5 shrink-0 mt-0.5 ${iconColor}`} aria-hidden="true" />
      <div class="min-w-0 flex-1">
        <h3
          id={cardId}
          class="text-lg font-bold text-base-content font-outfit scroll-mt-24 truncate leading-tight"
        >
          <a href={cardHref} class="hover:text-pink-400 transition-colors">
            {name}
          </a>
        </h3>
        <div class="flex items-center gap-2 mt-1 flex-wrap">
          <div class="text-[11px] text-base-content/40 font-mono truncate">{cardId}</div>
          <span
            class={`inline-flex items-center gap-1.5 h-6 px-2.5 rounded-full text-[10px] font-bold uppercase tracking-wider border ${nsfwInfo.classes}`}
            role="status"
          >
            <nsfwInfo.Icon class="w-3.5 h-3.5" aria-hidden="true" />
            {nsfwInfo.label}
          </span>
        </div>
      </div>
    </header>

    <!-- Description -->
    <p class="text-sm text-base-content/75 leading-relaxed line-clamp-3 min-h-18">
      {localizedDescription}
    </p>

    <!-- Section divider -->
    <hr class="border-base-content/10 m-0" />

    <!-- Stats: 3-column key/value (no boxes, label + value plain text) -->
    <dl class="grid grid-cols-3 text-center">
      <div class="flex flex-col gap-0.5 px-1">
        <dt class="text-[10px] font-bold text-base-content/50 uppercase tracking-wider">{common.context}</dt>
        <dd class="text-base font-extrabold text-base-content truncate">{context}</dd>
      </div>
      <div class="flex flex-col gap-0.5 px-1 border-x border-base-content/8">
        <dt class="text-[10px] font-bold text-base-content/50 uppercase tracking-wider">{common.size}</dt>
        <dd class="text-base font-extrabold text-base-content truncate">{artifactSize}</dd>
      </div>
      <div class="flex flex-col gap-0.5 px-1">
        <dt class="text-[10px] font-bold text-base-content/50 uppercase tracking-wider">{common.format}</dt>
        <dd class="text-base font-extrabold text-base-content truncate">{artifactFormat}</dd>
      </div>
    </dl>

    <hr class="border-base-content/10 m-0" />

    <!-- Features: label + compact capability icons row -->
    <section class="flex flex-col gap-2 min-h-9">
      {capabilities.length > 0 ? (
        <>
        <div class="text-[10px] font-bold text-base-content/50 uppercase tracking-wider">{common.features}</div>
        <Capabilities capabilities={capabilities} size="xs" />
        </>
      ) : (
        <span class="text-[10px] text-base-content/30 uppercase tracking-wider">{common.features}</span>
      )}
    </section>

    <!-- Meta strip: released + author + license (inline, subtle) -->
    <footer class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-base-content/75 leading-5 mt-auto pt-1">
      {released && (
        <span class="inline-flex items-center gap-1">
          <Calendar class="w-3 h-3 opacity-75" />
          {released}
        </span>
      )}
      <span class="inline-flex items-center gap-1">
        <User class="w-3 h-3 opacity-75" />
        {common.by} <span class="text-base-content/80 font-medium">{author}</span>
      </span>
      {localizedLicense && (
        <span class="inline-flex items-center gap-1">
          <ShieldCheck class="w-3 h-3 opacity-75" />
          {localizedLicense}
        </span>
      )}
    </footer>
  </div>

  <!-- Action bar: single primary action -->
  <div class="flex border-t border-base-content/10 mt-auto">
    <a
      href={cardHref}
      class="w-full flex items-center justify-center gap-1.5 py-2.5 text-sm font-semibold bg-pink-500/10 hover:bg-pink-500/20 text-pink-300 hover:text-pink-200 transition-colors"
    >
      <span>{common.details}</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>