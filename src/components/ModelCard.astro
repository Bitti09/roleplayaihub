---
import {
  Calendar,
  User,
  ShieldCheck,
  TriangleAlert,
  CircleAlert,
} from '@lucide/astro';
import type { ModelData } from '../content.config';
import { idFromName } from '../lib/slugify';
import { colorForName } from '../lib/colors';
import { resolveIcon } from '../lib/icons';
import Capabilities from './Capabilities.astro';
import ModelSettingsModal from './ModelSettingsModal.astro';

interface Props {
  data: ModelData;
}

const { data } = Astro.props;

const {
  name,
  author,
  released,
  description,
  size,
  format,
  context,
  license,
  nsfw,
  capabilities,
  settings,
  temperature,
} = data;

const cardId = idFromName(name);
const IconComponent = resolveIcon(data.icon);

/**
 * Pull the `text-*` class out of the palette so we can paint the bare icon
 * (no colored tile around it anymore).
 */
const iconColor =
  colorForName(name).split(' ').find((c) => c.startsWith('text-')) ?? 'text-pink-400';

/**
 * NSFW content-policy pill — visible on every card because content
 * classification is essential for an AI-model hub.
 * The visible label self-describes (subject + state); the pill itself acts as
 * the accessible name, so we deliberately skip a redundant aria-label.
 */
type NsfwValue = NonNullable<ModelData['nsfw']>;
const nsfwPill: Record<
  NsfwValue,
  { label: string; classes: string; Icon: typeof TriangleAlert }
> = {
  allowed: {
    label: 'NSFW Allowed',
    classes: 'bg-emerald-500/15 border-emerald-500/30 text-emerald-400',
    Icon: TriangleAlert,
  },
  limited: {
    label: 'NSFW Limited',
    classes: 'bg-amber-500/15 border-amber-500/30 text-amber-400',
    Icon: CircleAlert,
  },
  blocked: {
    label: 'NSFW Blocked',
    classes: 'bg-red-500/15 border-red-500/30 text-red-400',
    Icon: ShieldCheck,
  },
};
const nsfwInfo = nsfwPill[nsfw ?? 'blocked'];

/**
 * Whether the model has any recommended parameters to surface in the modal.
 * Drives the conditional "Settings" footer button.
 */
const hasSettings =
  temperature !== undefined ||
  (settings !== undefined && Object.values(settings).some((v) => v !== undefined));
---

<article
  class="card glass-panel overflow-hidden rounded-2xl transition-all duration-300 hover:shadow-[0_0_30px_-5px] hover:shadow-pink-500/20 flex flex-col"
>
  <div class="px-5 pt-5 pb-4 flex flex-col gap-3.5 grow">
    <!-- Header: small icon + name on top, slug id + NSFW pill below -->
    <header class="flex items-start gap-2.5 min-w-0">
      <IconComponent class={`w-5 h-5 shrink-0 mt-0.5 ${iconColor}`} aria-hidden="true" />
      <div class="min-w-0 flex-1">
        <h3
          id={cardId}
          class="text-lg font-bold text-base-content font-outfit scroll-mt-24 truncate leading-tight"
        >
          <a href={`/ai-models/${cardId}`} class="hover:text-pink-400 transition-colors">
            {name}
          </a>
        </h3>
        <div class="flex items-center gap-2 mt-1 flex-wrap">
          <div class="text-[11px] text-base-content/40 font-mono truncate">{cardId}</div>
          <span
            class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border ${nsfwInfo.classes}`}
            role="status"
          >
            <nsfwInfo.Icon class="w-3 h-3" aria-hidden="true" />
            {nsfwInfo.label}
          </span>
        </div>
      </div>
    </header>

    <!-- Description -->
    <p class="text-sm text-base-content/70 leading-relaxed line-clamp-3">
      {description}
    </p>

    <!-- Section divider -->
    <hr class="border-base-content/10 m-0" />

    <!-- Stats: 3-column key/value (no boxes, label + value plain text) -->
    <dl class="grid grid-cols-3 text-center">
      <div class="flex flex-col gap-0.5 px-1">
        <dt class="text-[10px] font-bold text-base-content/50 uppercase tracking-wider">Context</dt>
        <dd class="text-sm font-bold text-base-content truncate">{context}</dd>
      </div>
      <div class="flex flex-col gap-0.5 px-1 border-x border-base-content/8">
        <dt class="text-[10px] font-bold text-base-content/50 uppercase tracking-wider">Size</dt>
        <dd class="text-sm font-bold text-base-content truncate">{size}</dd>
      </div>
      <div class="flex flex-col gap-0.5 px-1">
        <dt class="text-[10px] font-bold text-base-content/50 uppercase tracking-wider">Format</dt>
        <dd class="text-sm font-bold text-base-content truncate">{format}</dd>
      </div>
    </dl>

    <hr class="border-base-content/10 m-0" />

    <!-- Features: label + compact capability icons row -->
    {capabilities.length > 0 && (
      <section class="flex flex-col gap-2">
        <div class="text-[10px] font-bold text-base-content/50 uppercase tracking-wider">Features</div>
        <Capabilities capabilities={capabilities} size="xs" />
      </section>
    )}

    <!-- Meta strip: released + author + license (inline, subtle) -->
    <footer class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-base-content/60 mt-auto pt-1">
      {released && (
        <span class="inline-flex items-center gap-1">
          <Calendar class="w-3 h-3 opacity-60" />
          {released}
        </span>
      )}
      <span class="inline-flex items-center gap-1">
        <User class="w-3 h-3 opacity-60" />
        by <span class="text-base-content/80 font-medium">{author}</span>
      </span>
      {license && (
        <span class="inline-flex items-center gap-1">
          <ShieldCheck class="w-3 h-3 opacity-60" />
          {license}
        </span>
      )}
    </footer>
  </div>

  <!-- Action bar: primary "Details" + optional "Settings" (borderless) -->
  <div class="flex border-t border-base-content/10 divide-x divide-base-content/10 mt-auto">
    <a
      href={`/ai-models/${cardId}`}
      class="flex-1 flex items-center justify-center gap-1.5 py-2.5 text-sm font-semibold bg-pink-500/10 hover:bg-pink-500/20 text-pink-300 hover:text-pink-200 transition-colors"
    >
      <span>Details</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
    {hasSettings && (
      <button
        type="button"
        class="flex-1 flex items-center justify-center gap-1.5 py-2.5 text-sm font-medium hover:bg-base-content/5 text-base-content/70 transition-colors"
        onclick={`document.getElementById('modal-${cardId}').showModal()`}
      >
        <span>Settings</span>
      </button>
    )}
  </div>

  <ModelSettingsModal name={name} cardId={cardId} data={data} />
</article>
