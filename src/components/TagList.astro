---
interface Props {
  tags: string[];
  label?: string;
}

const { tags, label = 'Tags' } = Astro.props;
---

{tags.length > 0 && (
  <div class="flex items-center gap-2">
    <span class="text-[10px] font-bold text-base-content/50 uppercase tracking-wider shrink-0">
      {label}:
    </span>
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="badge badge-sm bg-base-100 border-base-content/10 text-base-content/70 rounded px-2">
          {tag}
        </span>
      ))}
    </div>
  </div>
)}