---
import {
  getIntlayer,
  getLocaleFromPath,
  defaultLocale,
  type LocalesValues,
} from 'intlayer';

interface Props {
  tags: string[];
  label?: string;
}

const { tags, label } = Astro.props;
const detectedLocale = getLocaleFromPath(Astro.url.pathname) as
  | LocalesValues
  | undefined;
const currentLocale: LocalesValues = (detectedLocale ??
  defaultLocale) as LocalesValues;
const { tags: defaultLabel } = getIntlayer('common', currentLocale);
---

{tags.length > 0 && (
  <div class="flex items-center gap-2">
    <span class="text-[10px] font-bold text-base-content/50 uppercase tracking-wider shrink-0">
      {label ?? defaultLabel}:
    </span>
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="badge badge-sm bg-base-100 border-base-content/10 text-base-content/70 rounded px-2">
          {tag}
        </span>
      ))}
    </div>
  </div>
)}