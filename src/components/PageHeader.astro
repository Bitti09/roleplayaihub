---
import { ChevronRight } from '@lucide/astro';
import {
  getIntlayer,
  getLocaleFromPath,
  getPathWithoutLocale,
  getLocalizedUrl,
  defaultLocale,
  type LocalesValues,
} from 'intlayer';
import { getCollectionIcon } from '../lib/collections';
import { HEADER_ICON_GRADIENT } from '../lib/colors';
import { resolveLocalized, type LocalizedString } from '../lib/localized';

interface Props {
  collection: string;
  title: LocalizedString;
  description?: string;
}

const { collection, title, description } = Astro.props;

const CollectionIcon = getCollectionIcon(collection);

// Detect the current locale from the URL so the Home breadcrumb stays in
// the user's locale: on /de/... the link is /de and the label is German.
const detectedLocale = getLocaleFromPath(Astro.url.pathname) as
  | LocalesValues
  | undefined;
const htmlLang: LocalesValues = (detectedLocale ?? defaultLocale) as LocalesValues;
const homeHref = getLocalizedUrl(getPathWithoutLocale('/'), htmlLang);
const { home: homeLabel } = getIntlayer('common', htmlLang);
const { defaultDescription } = getIntlayer('collection', htmlLang);
// title may be a plain string or a per-locale map; resolve it for display.
const localizedTitle = resolveLocalized(title, htmlLang);
const resolvedDescription =
  description ?? defaultDescription.replace('{collection}', localizedTitle.toLowerCase());
---

<div class="mb-10">
  <div class="text-xs text-neutral-500 flex items-center gap-1.5 mb-3">
    <a href={homeHref} class="hover:text-neutral-300 transition-colors">{homeLabel}</a>
    <ChevronRight class="w-3 h-3 opacity-60" />
    <span class="text-neutral-400">{localizedTitle}</span>
  </div>
  <div class="flex items-center gap-4">
    <div class={`p-3 rounded-2xl border ${HEADER_ICON_GRADIENT}`}>
      <CollectionIcon class="w-7 h-7" />
    </div>
    <div>
      <h1 class="font-outfit font-extrabold text-3xl sm:text-4xl text-neutral-100">
        {localizedTitle}
      </h1>
      <p class="text-sm text-neutral-400 mt-1.5">
        {resolvedDescription}
      </p>
    </div>
  </div>
</div>