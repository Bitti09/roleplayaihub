---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import ModelCard from '../components/ModelCard.astro';
import Sidebar from '../components/Sidebar.astro';
import PageHeader from '../components/PageHeader.astro';
import EmptyState from '../components/EmptyState.astro';

import { getEntry } from 'astro:content';
import {
  CONTENT_COLLECTIONS,
  fetchCollection,
  isContentCollection,
  type ContentCollection,
} from '../lib/collections';
import { buildStructuredCollectionData } from '../lib/collection-structure';
import {
  getIntlayer,
  getLocaleFromPath,
  defaultLocale,
  type LocalesValues,
} from 'intlayer';
import type { ModelData, ResourceData } from '../content.config';

export function getStaticPaths() {
  return CONTENT_COLLECTIONS.map((collection) => ({ params: { collection } }));
}

const { collection } = Astro.params;

if (!collection || !isContentCollection(collection)) {
  return Astro.redirect('/404');
}

// `isContentCollection` narrowed `collection` to `ContentCollection`,
// so this call returns the typed entry array.
const items = await fetchCollection(collection);
const navigation = await getEntry('navigation', collection);

if (!navigation) {
  return Astro.redirect('/404');
}

// Resolve the current locale from the URL (this file renders the
// default locale; the [lang] variant handles prefixed paths).
const detectedLocale = getLocaleFromPath(Astro.url.pathname) as
  | LocalesValues
  | undefined;
const currentLocale: LocalesValues = (detectedLocale ??
  defaultLocale) as LocalesValues;
const defaultLocaleStr = defaultLocale as string;
const structuredData = buildStructuredCollectionData(
  navigation.data,
  items,
  currentLocale,
  defaultLocaleStr,
);

const isModelCollection = collection === ('ai-models' satisfies ContentCollection);
const common = getIntlayer('common');
---

<Layout title={navigation.data.title}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <PageHeader
      collection={collection}
      title={navigation.data.title}
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <Sidebar navigation={navigation.data} />

      <div class="lg:col-span-9 flex flex-col gap-16" data-pagefind-body>
        {structuredData.map((category) => {
          const totalItems = category.subcategories.reduce(
            (acc, sub) => acc + sub.items.length,
            0,
          );
          return (
            <section id={category.slug} class="flex flex-col gap-8 scroll-mt-24">
              <div class="border-b border-white/5 pb-3 flex items-center justify-between">
                <h2 class="font-outfit font-extrabold text-2xl text-neutral-200 uppercase tracking-wide">
                  {category.name}
                </h2>
                <span class="text-xs font-medium text-neutral-500 px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800">
                  {totalItems} {common.items}
                </span>
              </div>

              <div class="flex flex-col gap-12">
                {category.subcategories.map((sub) => (
                  <div id={sub.slug} class="scroll-mt-24 subcategory-section">
                    <h3 class="text-base font-bold text-neutral-300 flex items-center gap-2 mb-5">
                      <span class="w-1.5 h-1.5 rounded-full bg-pink-500"></span>
                      {sub.name}
                      <span class="text-xs font-normal text-neutral-500">
                        ({sub.items.length})
                      </span>
                    </h3>

                    {sub.items.length > 0 ? (
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        {sub.items.map((item) =>
                          isModelCollection ? (
                            <ModelCard data={item.data as ModelData} />
                          ) : (
                            <Card data={item.data as ResourceData} />
                          ),
                        )}
                      </div>
                    ) : (
                      <EmptyState />
                    )}
                  </div>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </div>

  <script>
    import '../scripts/scrollSpy.ts';
  </script>
</Layout>
