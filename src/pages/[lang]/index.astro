---
import Layout from '../../layouts/Layout.astro';
import {
  Brain,
  MessageSquare,
  Image,
  Mic,
  LayoutDashboard as WebIcon,
  Laptop,
  Smartphone,
  Terminal,
  Server,
  Settings,
  ArrowRight,
} from '@lucide/astro';
import { slugify } from '../../lib/slugify';
import { COLOR_PALETTE } from '../../lib/colors';
import { getIntlayer, defaultLocale, locales, type LocalesValues } from 'intlayer';

export function getStaticPaths() {
  return (locales as readonly string[])
    .filter((l) => l !== defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocalesValues;
if (lang === defaultLocale) {
  return Astro.redirect('/');
}

// Force German strings for this build.
const home = getIntlayer('home', lang);

interface Category {
  title: string;
  description: string;
  icon: any;
  color: string;
  href: string;
}

const categories: Category[] = [
  { title: home.categoryTextModelsTitle, description: home.categoryTextModelsDescription, icon: MessageSquare, color: COLOR_PALETTE[6], href: `/${lang}/ai-models#${slugify(home.categoryTextModelsTitle)}` },
  { title: home.categoryImageModelsTitle, description: home.categoryImageModelsDescription, icon: Image, color: COLOR_PALETTE[1], href: `/${lang}/ai-models#${slugify(home.categoryImageModelsTitle)}` },
  { title: home.categoryAudioModelsTitle, description: home.categoryAudioModelsDescription, icon: Mic, color: COLOR_PALETTE[7], href: `/${lang}/ai-models#${slugify(home.categoryAudioModelsTitle)}` },
  { title: home.categoryWebClientsTitle, description: home.categoryWebClientsDescription, icon: WebIcon, color: COLOR_PALETTE[3], href: `/${lang}/frontends#${slugify(home.categoryWebClientsTitle)}` },
  { title: home.categoryDesktopClientsTitle, description: home.categoryDesktopClientsDescription, icon: Laptop, color: COLOR_PALETTE[4], href: `/${lang}/frontends#${slugify(home.categoryDesktopClientsTitle)}` },
  { title: home.categoryMobileClientsTitle, description: home.categoryMobileClientsDescription, icon: Smartphone, color: COLOR_PALETTE[5], href: `/${lang}/frontends#${slugify(home.categoryMobileClientsTitle)}` },
  { title: home.categoryCliClientsTitle, description: home.categoryCliClientsDescription, icon: Terminal, color: COLOR_PALETTE[0], href: `/${lang}/frontends#${slugify(home.categoryCliClientsTitle)}` },
  { title: home.categoryInferenceServersTitle, description: home.categoryInferenceServersDescription, icon: Server, color: COLOR_PALETTE[8], href: `/${lang}/tools#${slugify(home.categoryInferenceServersTitle)}` },
  { title: home.categoryDevToolsTitle, description: home.categoryDevToolsDescription, icon: Settings, color: COLOR_PALETTE[9], href: `/${lang}/tools#${slugify(home.categoryDevToolsTitle)}` },
];
---

<Layout title={home.pageTitle} pagefindIgnore={true}>
  <div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-20 md:pt-24 md:pb-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-xs font-semibold text-neutral-300 mb-6 shadow-sm">
            <span>{home.heroBadge}</span>
          </div>
          <h1 class="font-outfit font-extrabold text-4xl sm:text-5xl md:text-7xl tracking-tight leading-none">
            <span class="bg-linear-to-r from-white via-neutral-100 to-neutral-400 bg-clip-text text-transparent">
              {home.heroHeadline.split(' ').slice(0, 2).join(' ')}
              <span class="bg-linear-to-r from-orange-400 via-pink-500 to-purple-600 bg-clip-text text-transparent">{home.heroHeadline.split(' ').slice(2).join(' ')}</span>
            </span>
          </h1>
          <p class="mt-4 text-lg md:text-xl text-neutral-400 font-medium max-w-lg">{home.heroTagline}</p>
          <div class="mt-8 flex flex-wrap justify-center lg:justify-start gap-3">
            <a href={`/${lang}/ai-models`} class="btn btn-sm sm:btn-md rounded-full px-5 bg-pink-600 hover:bg-pink-700 border-none text-white shadow-lg shadow-pink-600/20 font-medium">{home.ctaExplore}</a>
            <a href={`/${lang}/frontends`} class="btn btn-sm sm:btn-md rounded-full px-5 btn-neutral font-medium">{home.ctaFrontends}</a>
            <a href={`/${lang}/tools`} class="btn btn-sm sm:btn-md rounded-full px-5 btn-neutral font-medium">{home.ctaTools}</a>
          </div>
        </div>
        <div class="lg:col-span-5 flex justify-center items-center relative">
          <div class="absolute w-72 h-72 rounded-full bg-linear-to-tr from-pink-500/20 via-purple-500/20 to-blue-500/25 blur-3xl -z-10"></div>
          <div class="absolute w-48 h-48 rounded-full bg-linear-to-tr from-blue-500/10 via-pink-500/10 to-transparent blur-2xl -z-10 animate-pulse"></div>
          <div class="brain-glow relative p-12 rounded-[2.5rem] glass-panel flex justify-center items-center group transition-all duration-500 hover:scale-[1.02] cursor-pointer">
            <Brain class="w-32 h-32 text-white drop-shadow-[0_0_15px_rgba(236,72,153,0.8)] opacity-95 group-hover:scale-105 transition-transform duration-300" />
          </div>
        </div>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex items-center justify-center gap-4 my-8">
        <div class="h-px bg-white/5 grow max-w-xs"></div>
        <span class="text-xs font-semibold tracking-wider text-neutral-500 uppercase flex items-center gap-1.5">{home.categoriesDivider}</span>
        <div class="h-px bg-white/5 grow max-w-xs"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-10">
        {categories.map((cat) => {
          const Icon = cat.icon;
          return (
            <a href={cat.href} class="card glass-panel glass-panel-hover overflow-hidden rounded-2xl transition-all duration-300 group cursor-pointer">
              <div class="card-body p-6 flex flex-col justify-between h-full gap-4">
                <div>
                  <div class={`w-10 h-10 rounded-xl border flex items-center justify-center mb-4 shrink-0 transition-transform group-hover:scale-110 duration-300 ${cat.color}`}>
                    <Icon class="w-5 h-5" />
                  </div>
                  <h2 class="text-base font-bold text-neutral-100 group-hover:text-pink-400 transition-colors flex items-center justify-between">
                    {cat.title}
                    <ArrowRight class="w-4 h-4 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" />
                  </h2>
                  <p class="text-xs text-neutral-400 mt-2 leading-relaxed">{cat.description}</p>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</Layout>